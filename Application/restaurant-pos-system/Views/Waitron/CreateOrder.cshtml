@model IEnumerable<restaurant_pos_system.Models.MenuItem>
@{
    ViewData["Title"] = "Create Order";
    Layout = null;
    var grouped = Model.GroupBy(m => m.MenuCategory.Name);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Create Order</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">🍽️ Table @ViewBag.TableNumber — New Order</span>
        <a href="/Waitron/MyTables" class="btn btn-outline-light btn-sm">← Back</a>
    </nav>
    <div class="container mt-4">
        <form method="post" action="/Waitron/SubmitOrder">
            <input type="hidden" name="tableId" value="@ViewBag.TableId" />
            <div class="row">
                <div class="col-md-8">
                    @foreach (var group in grouped)
                    {
                        <h5 class="mt-3">@group.Key</h5>
                        <div class="row g-2">
                            @foreach (var item in group)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="card">
                                        <div class="card-body p-2">
                                            <p class="mb-1 fw-bold">@item.Name</p>
                                            <p class="mb-1 text-muted small">R @item.Price.ToString("F2")</p>
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="hidden" name="menuItemIds" value="@item.Id" />
                                                <label class="small">Qty:</label>
                                                <input type="number" name="quantities" value="0" min="0" max="20"
                                                       class="form-control form-control-sm" style="width:65px;"
                                                       onchange="updateSummary()" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm sticky-top" style="top:20px;">
                        <div class="card-body">
                            <h5>Order Summary</h5>
                            <div id="summary"><p class="text-muted">No items yet.</p></div>
                            <hr />
                            <p><strong>Total: R <span id="total">0.00</span></strong></p>
                            <div class="mb-2">
                                <label class="form-label small">Special Notes</label>
                                <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Allergies, preferences..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Send to Kitchen</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <script>
        const prices = { @Html.Raw(string.Join(",", Model.Select(m => $"{m.Id}:{m.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}"))) };
        const names  = { @Html.Raw(string.Join(",", Model.Select(m => $"{m.Id}:'{m.Name}'"))) };

        function updateSummary() {
            const inputs = document.querySelectorAll('input[name="quantities"]');
            const ids    = document.querySelectorAll('input[name="menuItemIds"]');
            let html = '', total = 0;
            inputs.forEach((inp, i) => {
                const qty = parseInt(inp.value) || 0;
                const id  = parseInt(ids[i].value);
                if (qty > 0) {
                    const sub = qty * prices[id];
                    total += sub;
                    html += `<div class="d-flex justify-content-between small"><span>${names[id]} x${qty}</span><span>R ${sub.toFixed(2)}</span></div>`;
                }
            });
            document.getElementById('summary').innerHTML = html || '<p class="text-muted">No items yet.</p>';
            document.getElementById('total').textContent = total.toFixed(2);
        }
    </script>
</body>
</html>