@model IEnumerable<restaurant_pos_system.Models.Order>
@{
    ViewData["Title"] = "Table Orders";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Table Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">🍽️ Table @ViewBag.TableNumber — Orders</span>
        <a href="/Waitron/MyTables" class="btn btn-outline-light btn-sm">← Back</a>
    </nav>
    <div class="container mt-4">
        @if (!Model.Any())
        {
            <div class="alert alert-info">No active orders for this table.</div>
        }
        @foreach (var order in Model)
        {
            decimal total = order.OrderItems.Sum(i => i.Price * i.Quantity);
            <div class="card mb-3 shadow-sm">
                <div class="card-header d-flex justify-content-between">
                    <span><strong>Order #@order.Id</strong></span>
                    <span class="badge bg-secondary">@order.Status</span>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-2">
                        <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
                        <tbody>
                            @foreach (var item in order.OrderItems)
                            {
                                <tr>
                                    <td>@item.MenuItem?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>R @item.Price.ToString("F2")</td>
                                    <td>R @((item.Price * item.Quantity).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p><strong>Total: R @total.ToString("F2")</strong></p>
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <p class="text-muted small">Notes: @order.Notes</p>
                    }
                    @if (order.Status == "Ready" || order.Status == "Completed")
                    {
                        <form method="post" action="/Waitron/PayOrder" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <select name="paymentMethod" class="form-select form-select-sm" style="width:150px;">
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                            </select>
                            <button type="submit" class="btn btn-success btn-sm">💳 Pay & Print Receipt</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted small">Waiting for kitchen to mark as Ready before payment.</p>
                    }
                </div>
            </div>
        }
        <a href="/Waitron/CreateOrder?tableId=@ViewBag.TableId" class="btn btn-outline-success">+ Add Another Order</a>
    </div>
</body>
</html>