@model IEnumerable<restaurant_pos_system.Models.RestaurantTable>
@{
    ViewData["Title"] = "My Tables";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Waiter — Tables</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">🍽️ Emerald POS — Waiter</span>
        <a href="/Account/Logout" class="btn btn-outline-light btn-sm">Logout</a>
    </nav>
    <div class="container mt-4">
        <h4 class="mb-3">Select a Table</h4>
        <div class="row g-3">
            @foreach (var table in Model)
            {
                var badgeColor = table.Status == "Available" ? "success" : table.Status == "Reserved" ? "warning" : "danger";
                <div class="col-6 col-md-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">Table @table.TableNumber</h5>
                            <p class="card-text">Seats: @table.Capacity</p>
                            <span class="badge bg-@badgeColor mb-2">@table.Status</span>
                            <br />
                            @if (table.Status == "Occupied")
                            {
                                <a href="/Waitron/TableOrders?tableId=@table.Id" class="btn btn-warning btn-sm mt-1">View Order</a>
                            }
                            else
                            {
                                <a href="/Waitron/CreateOrder?tableId=@table.Id" class="btn btn-success btn-sm mt-1">New Order</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>