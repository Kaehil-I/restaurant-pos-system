@model List<restaurant_pos_system.Models.RestaurantTable>

<h1>My Tables</h1>

<div class="tables-grid">
    @foreach (var table in Model)
    {
        <div class="table-card">
            <h3>Table @table.TableNumber</h3>
            <p>Status: @table.Status</p>

            <a asp-controller="Waitron"
               asp-action="CreateOrder"
               asp-route-tableId="@table.Id"
               class="btn-primary">
                Open Order
            </a>
        </div>
    }
</div>