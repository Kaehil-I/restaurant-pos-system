@model restaurant_pos_system.Models.Order
@{
    var orderType = Model.RestaurantTable != null ? "Dine-In" : "Pickup";
    var statusSlug = Model.Status?.ToLower().Replace(" ", "") ?? "pending";
    var pendingCount = Model.OrderItems?.Count(i => i.KitchenStatus == "Pending") ?? 0;
    var readyCount = Model.OrderItems?.Count(i => i.KitchenStatus == "Ready") ?? 0;
}

<div class="order-card">

    <p class="order-card-title">Order #@Model.Id</p>

    <div class="order-card-badges">
        @if (orderType == "Dine-In")
        {
            <span class="badge-type badge-dinein">Dine-In</span>
        }
        else
        {
            <span class="badge-type badge-pickup">Pickup</span>
        }

        <span class="badge-status badge-@statusSlug">@Model.Status</span>

        @if (pendingCount > 0)
        {
            <span class="badge-status badge-pending">@pendingCount Pending</span>
        }
        @if (readyCount > 0)
        {
            <span class="badge-status badge-ready">@readyCount Ready</span>
        }
    </div>

    @if (Model.RestaurantTable != null)
    {
        <p style="font-size:13px; color:var(--text-secondary); margin:0;">
            Table @Model.RestaurantTable.TableNumber &middot; Seats @Model.RestaurantTable.Capacity
        </p>
    }

    <div>
        <p class="order-card-notes-label">Notes:</p>
        <p class="order-card-notes-text">
            @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)
        </p>
    </div>

    <a asp-controller="Kitchen"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn-view-order">
        View Order
    </a>

</div>