@model restaurant_pos_system.Models.Order
@{
    ViewData["Title"] = "Receipt";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                background: white !important;
            }

            .card {
                border: none !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="container mt-4" style="max-width:480px;">
        <div class="card shadow p-4">

            <div class="text-center mb-3">
                <h3 class="fw-bold">🧾 Emerald POS</h3>
                <p class="text-muted mb-0">Official Receipt</p>
                <hr />
            </div>

            <div class="mb-3">
                <p class="mb-1"><strong>Receipt #:</strong> @Model.Id</p>
                <p class="mb-1"><strong>Table:</strong> @Model.RestaurantTable?.TableNumber</p>
                <p class="mb-1"><strong>Date:</strong> @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                @if (Model.Payment != null)
                {
                    <p class="mb-1"><strong>Payment:</strong> @Model.Payment.PaymentMethod</p>
                    <p class="mb-1"><strong>Paid At:</strong> @Model.Payment.PaidAt.ToString("dd MMM yyyy HH:mm")</p>
                }
            </div>

            <hr />

            <table class="table table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.MenuItem?.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">R @item.Price.ToString("F2")</td>
                            <td class="text-end">R @((item.Price * item.Quantity).ToString("F2"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-dark">
                        <td colspan="3"><strong>TOTAL</strong></td>
                        <td class="text-end"><strong>R @Model.OrderItems.Sum(i => i.Price * i.Quantity).ToString("F2")</strong></td>
                    </tr>
                </tfoot>
            </table>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="text-muted small">📝 Notes: @Model.Notes</p>
            }

            <hr />
            <p class="text-center text-muted">Thank you for dining with us! 😊</p>
            <p class="text-center text-muted small">Emerald POS System</p>

            <div class="d-flex gap-2 justify-content-center mt-3 no-print">
                <button class="btn btn-primary" onclick="window.print()">🖨️ Print Receipt</button>
                <a href="/Waitron/MyTables" class="btn btn-secondary">← Back to Tables</a>
                <a href="/Manager/Sales" class="btn btn-outline-dark">📊 Sales</a>
            </div>

        </div>
    </div>
</body>
</html>