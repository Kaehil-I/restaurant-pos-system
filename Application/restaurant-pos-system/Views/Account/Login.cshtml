<!DOCTYPE html>
<html>
<head>
    <title>Emerald POS - Staff Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #f4f6f9, #e9ecef);
            --panel-bg: #ffffff;
            --text-primary: #1f2a38;
            --text-secondary: #6c757d;
            --card-bg: #ffffff;
        }

        body.dark-mode {
            --bg-gradient: linear-gradient(135deg, #1f2a38, #2c3e50);
            --panel-bg: #18222f;
            --text-primary: #ffffff;
            --text-secondary: #b0b8c1;
            --card-bg: #243447;
        }

        /* Management Button - Light Mode */
        .management-btn {
            background-color: #1f2a38;
            color: #ffffff;
            border: none;
        }

            .management-btn:hover {
                background-color: #2c3e50;
                transform: scale(1.03);
            }

        /* Management Button - Dark Mode */
        body.dark-mode .management-btn {
            background-color: #00c27a; /* Emerald highlight */
            color: #ffffff;
        }

            body.dark-mode .management-btn:hover {
                background-color: #00a86b;
            }

        body {
            margin: 0;
            height: 100vh;
            background: var(--bg-gradient);
            font-family: 'Segoe UI', sans-serif;
            transition: 0.3s ease;
        }

        .container-fluid {
            height: 100vh;
        }

        .left-panel {
            background: var(--panel-bg);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            transition: 0.3s ease;
        }

        .logo {
            width: 240px;
            margin-bottom: 40px;
        }

        .welcome-text h1 {
            font-size: 38px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .welcome-text p {
            font-size: 18px;
            color: var(--text-secondary);
            margin-bottom: 50px;
        }

        .role-btn {
            width: 100%;
            padding: 30px;
            font-size: 24px;
            font-weight: 700;
            border-radius: 18px;
            margin-bottom: 25px;
            transition: 0.2s ease;
        }

            .role-btn:hover {
                transform: scale(1.03);
            }

        .pin-box {
            background: var(--card-bg);
            padding: 50px;
            border-radius: 25px;
            width: 420px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
            transition: 0.3s ease;
        }

            .pin-box h4 {
                color: var(--text-primary);
            }

        .pin-display {
            font-size: 36px;
            text-align: center;
            letter-spacing: 14px;
            border-bottom: 2px solid #ccc;
            margin-bottom: 35px;
            padding-bottom: 15px;
            color: var(--text-primary);
        }

        .keypad button {
            height: 80px;
            font-size: 24px;
            font-weight: bold;
            border-radius: 18px;
        }

        .mode-toggle {
            position: absolute;
            top: 20px;
            right: 30px;
        }

        .form-check-label {
            color: var(--text-primary);
        }
    </style>
</head>

<body>

    <div class="mode-toggle form-check form-switch">
        <input class="form-check-input" type="checkbox" id="modeSwitch">
        <label class="form-check-label" for="modeSwitch">Dark Mode</label>
    </div>

    <div class="container-fluid">
        <div class="row h-100">

            <!-- LEFT SIDE -->
            <div class="col-md-6 left-panel">

                <!-- LOGO -->
                <img src="emerald-logo.png" class="logo" alt="Emerald POS Logo">

                <!-- WELCOME TEXT -->
                <div class="welcome-text">
                    <h1>Welcome to Emerald POS</h1>
                    <p>Select your role to continue</p>
                </div>

                <!-- ROLE BUTTONS -->
                <button class="btn btn-outline-success role-btn">Waiter</button>
                <button class="btn btn-outline-warning role-btn">Kitchen</button>
                <button class="btn role-btn management-btn">Management</button>

            </div>

            <!-- RIGHT SIDE -->
            <div class="col-md-6 d-flex justify-content-center align-items-center">

                <div class="pin-box">
                    <h4 class="text-center mb-4">Enter 4-Digit PIN</h4>

                    <div class="pin-display">• • • •</div>

                    <div class="keypad">

                        <div class="row g-3 mb-3">
                            <div class="col-4"><button class="btn btn-light w-100">1</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">2</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">3</button></div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-4"><button class="btn btn-light w-100">4</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">5</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">6</button></div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-4"><button class="btn btn-light w-100">7</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">8</button></div>
                            <div class="col-4"><button class="btn btn-light w-100">9</button></div>
                        </div>

                        <div class="row g-3">
                            <div class="col-4">
                                <button class="btn btn-danger w-100">Clear</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-light w-100">0</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-success w-100">Login</button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>

    <script>
        const toggle = document.getElementById("modeSwitch");

        toggle.addEventListener("change", function () {
            document.body.classList.toggle("dark-mode");
        });
    </script>

</body>
</html>