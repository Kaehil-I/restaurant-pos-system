@model restaurant_pos_system.Models.AccountViewModel
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Emerald POS - Staff Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #f4f6f9, #e9ecef);
            --panel-bg: #ffffff;
            --text-primary: #1f2a38;
            --text-secondary: #6c757d;
            --card-bg: #ffffff;
        }

        body.dark-mode {
            --bg-gradient: linear-gradient(135deg, #1f2a38, #2c3e50);
            --panel-bg: #18222f;
            --text-primary: #ffffff;
            --text-secondary: #b0b8c1;
            --card-bg: #243447;
        }

        /* Management Button - Light Mode */
        .management-btn {
            background-color: #1f2a38;
            color: #ffffff;
            border: none;
        }

            .management-btn:hover {
                background-color: #2c3e50;
                transform: scale(1.03);
            }

        /* Management Button - Dark Mode */
        body.dark-mode .management-btn {
            background-color: #00c27a; /* Emerald highlight */
            color: #ffffff;
        }

            body.dark-mode .management-btn:hover {
                background-color: #00a86b;
            }

        body {
            margin: 0;
            height: 100vh;
            background: var(--bg-gradient);
            font-family: 'Segoe UI', sans-serif;
            transition: 0.3s ease;
        }

        .container-fluid {
            height: 100vh;
        }

        .left-panel {
            background: var(--panel-bg);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 70px;
            transition: 0.3s ease;
        }

        .logo {
            width: 240px;
            margin-bottom: 10px;
            display: block;
        }

        .welcome-text h1 {
            font-size: 34px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .welcome-text p {
            font-size: 18px;
            color: var(--text-secondary);
            margin-bottom: 50px;
        }

        .role-btn {
            width: 100%;
            padding: 30px;
            font-size: 24px;
            font-weight: 700;
            border-radius: 18px;
            margin-bottom: 25px;
            transition: 0.2s ease;
        }

            .role-btn:hover {
                transform: scale(1.03);
            }

            .role-btn.active {
                box-shadow: 0 10px 30px rgba(0,0,0,0.12);
                transform: scale(1.02);
            }

        .pin-box {
            background: var(--card-bg);
            padding: 50px;
            border-radius: 25px;
            width: 420px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
            transition: 0.3s ease;
        }

            .pin-box h4 {
                color: var(--text-primary);
            }

        .pin-display {
            font-size: 36px;
            text-align: center;
            letter-spacing: 14px;
            border-bottom: 2px solid #ccc;
            margin-bottom: 15px;
            padding-bottom: 15px;
            color: var(--text-primary);
            min-height: 56px;
        }

        .keypad button {
            height: 80px;
            font-size: 24px;
            font-weight: bold;
            border-radius: 18px;
        }

        .mode-toggle {
            position: absolute;
            top: 20px;
            right: 30px;
        }

        .form-check-label {
            color: var(--text-primary);
        }

        .error-text {
            color: #b00020;
            margin-top: 12px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="mode-toggle form-check form-switch">
        <input class="form-check-input" type="checkbox" id="modeSwitch">
        <label class="form-check-label" for="modeSwitch">Dark Mode</label>
    </div>

    <div class="container-fluid">
        <div class="row h-100">

            <!-- LEFT SIDE -->
            <div class="col-md-6 left-panel">

                <!-- LOGO -->
                <img src="~/images/emerald_pos_logo.png" class="logo" alt="Emerald POS Logo" asp-append-version="true">

                <!-- WELCOME TEXT -->
                <div class="welcome-text">
                    <h1>Welcome to Emerald POS</h1>
                    <p>Select your role to continue</p>
                </div>

                <!-- ROLE BUTTONS -->
                <button type="button" class="btn btn-success role-btn" data-role="Waiter">Waiter</button>
                <button type="button" class="btn btn-warning role-btn" data-role="Kitchen">Kitchen</button>
                <button type="button" class="btn role-btn management-btn" data-role="Manager">Management</button>

            </div>

            <!-- RIGHT SIDE -->
            <div class="col-md-6 d-flex justify-content-center align-items-center">

                <div class="pin-box">
                    <h4 class="text-center mb-2">Enter 4-Digit PIN</h4>

                    <!-- Display server-side errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="error-text">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="pin-display" id="pinDisplay">• • • •</div>

                    <div class="keypad">
                        <form id="loginForm" method="post" action="/Account/Login">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="RoleInput" name="Role" value="" />
                            <input type="hidden" id="PinInput" name="Pin" value="" />

                            <div class="row g-3 mb-3">
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">1</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">2</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">3</button></div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">4</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">5</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">6</button></div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">7</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">8</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 key">9</button></div>
                            </div>

                            <div class="row g-3">
                                <div class="col-4">
                                    <button type="button" class="btn btn-danger w-100" id="clearBtn">Clear</button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-light w-100 key">0</button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-success w-100" id="submitBtn">Login</button>
                                </div>
                            </div>
                        </form>
                        <div id="clientError" class="error-text" style="display:none;"></div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <script>
        const toggle = document.getElementById("modeSwitch");
        toggle.addEventListener("change", function () {
            document.body.classList.toggle("dark-mode");
        });

        // Role selection
        const roleButtons = document.querySelectorAll(".role-btn");
        const roleInput = document.getElementById("RoleInput");
        let selectedRole = "";

        roleButtons.forEach(btn => {
            btn.addEventListener("click", () => {
                roleButtons.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                selectedRole = btn.getAttribute("data-role");
                roleInput.value = selectedRole;
            });
        });

        // PIN keypad logic
        const keys = document.querySelectorAll(".key");
        const pinDisplay = document.getElementById("pinDisplay");
        const pinInput = document.getElementById("PinInput");
        const clearBtn = document.getElementById("clearBtn");
        const submitBtn = document.getElementById("submitBtn");
        const clientError = document.getElementById("clientError");

        let currentPin = "";

        function refreshPinDisplay() {
            if (currentPin.length === 0) {
                pinDisplay.textContent = "• • • •";
                return;
            }

            // Show filled bullets for entered digits and dots for remaining
            const filled = Array(currentPin.length).fill("•");
            const empty = Array(4 - currentPin.length).fill("•");
            pinDisplay.textContent = filled.concat(empty).join(" ");
        }

        keys.forEach(k => {
            k.addEventListener("click", () => {
                if (currentPin.length >= 4) return;
                currentPin += k.textContent.trim();
                pinInput.value = currentPin;
                refreshPinDisplay();
                clientError.style.display = "none";
            });
        });

        clearBtn.addEventListener("click", () => {
            currentPin = "";
            pinInput.value = "";
            refreshPinDisplay();
            clientError.style.display = "none";
        });

        submitBtn.addEventListener("click", () => {
            clientError.style.display = "none";
            if (!selectedRole) {
                clientError.textContent = "Please select a role.";
                clientError.style.display = "block";
                return;
            }

            if (currentPin.length !== 4) {
                clientError.textContent = "Please enter a 4-digit PIN.";
                clientError.style.display = "block";
                return;
            }

            // Submit form
            document.getElementById("loginForm").submit();
        });

        // initialize UI
        refreshPinDisplay();
    </script>

</body>
</html>