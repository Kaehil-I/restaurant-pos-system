<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Emerald POS</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://kit.fontawesome.com/yourkit.js" crossorigin="anonymous"></script>
</head>
<body id="body">

    <div class="container">

        <!-- Sidebar -->
        <div class="sidebar">
            <h2>💎 Emerald POS</h2>

            <ul>
                <li><a asp-controller="Manager" asp-action="Dashboard">Dashboard</a></li>
                <li><a asp-controller="Manager" asp-action="Orders">Orders</a></li>
                <li><a asp-controller="Manager" asp-action="Stock">Stock</a></li>
                <li><a asp-controller="Manager" asp-action="Staff">Staff</a></li>
            </ul>

            <!-- Theme Switch -->
            <div class="theme-switch">
                <span>🌞</span>
                <label class="switch">
                    <input type="checkbox" id="themeToggle">
                    <span class="slider round"></span>
                </label>
                <span>🌙</span>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            @RenderBody()
        </div>

    </div>

    <script>
        const toggle = document.getElementById("themeToggle");
        toggle.addEventListener("change", function () {
            document.body.classList.toggle("light-mode");
        });
    </script>

</body>
</html>