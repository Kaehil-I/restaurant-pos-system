<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Emerald POS Systems</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <style>
        :root {
            --emerald-dark: #0f5132;
            --emerald-light: #4ade80;
            --dark-bg: #2b2f33;
        }

        body {
            transition: 0.3s ease;
            font-family: Segoe UI, sans-serif;
        }

            body.light-mode {
                background: #f8f9fa;
                color: #212529;
            }

            body.dark-mode {
                background: var(--dark-bg);
                color: #f1f1f1;
            }

        .sidebar {
            min-height: 100vh;
            padding: 20px;
        }

        body.light-mode .sidebar {
            background: white;
            border-right: 1px solid #ddd;
        }

        body.dark-mode .sidebar {
            background: #1f1f1f;
        }

        .sidebar a {
            display: block;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            text-decoration: none;
        }

        body.light-mode .sidebar a:hover {
            background: var(--emerald-dark);
            color: white;
        }

        body.dark-mode .sidebar a:hover {
            background: var(--emerald-light);
            color: black;
        }

        .card {
            border-radius: 12px;
        }

        th {
            background: var(--emerald-dark);
            color: white;
        }

        body.dark-mode th {
            background: var(--emerald-light);
            color: black;
        }
    </style>
</head>

<body class="light-mode">

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <div class="col-2 sidebar">
                <h4 class="mb-4">Emerald POS</h4>

                <a asp-controller="Manager" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Manager" asp-action="CreatedOrders">Orders</a>
                <a asp-controller="Manager" asp-action="Stock">Stock</a>
                <a asp-controller="Manager" asp-action="Staff">Staff</a>

                <hr />

                <button id="themeToggle" class="btn btn-sm btn-outline-success w-100">
                    Toggle Theme
                </button>
            </div>

            <!-- Content -->
            <div class="col-10 p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script>
        const toggle = document.getElementById("themeToggle");

        toggle.addEventListener("click", () => {
            document.body.classList.toggle("dark-mode");
            document.body.classList.toggle("light-mode");
        });
    </script>

</body>
</html>