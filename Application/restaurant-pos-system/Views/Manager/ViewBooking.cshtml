<!DOCTYPE html>
<html>
<head>
    <title>Reservations Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background-color: #f4f6f9;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }

        .status-confirmed {
            color: green;
            font-weight: bold;
        }

        .status-pending {
            color: orange;
            font-weight: bold;
        }

        .status-cancelled {
            color: red;
            font-weight: bold;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Increase column spacing */
        table th, table td {
            padding: 18px 25px !important;
        }

        .modal-content {
            border-radius: 15px;
        }
    </style>
</head>
<body class="p-4">

    <div class="header-bar mb-4">
        <h2>Reservations Manager</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newReservationModal">
            + New Reservation
        </button>
    </div>

    <div class="card p-4">
        <div class="row mb-4">
            <div class="col-md-4">
                <input type="date" class="form-control">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search by name or phone">
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Guest Name</th>
                    <th>Time</th>
                    <th>Guests</th>
                    <th>Table</th>
                    <th>Status</th>
                    <th>Allocate</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>John Smith</td>
                    <td>18:30</td>
                    <td>4</td>
                    <td>Unassigned</td>
                    <td class="status-pending">Pending</td>
                    <td>
                        <select class="form-select">
                            <option>Select Table</option>
                            <option>Table 1</option>
                            <option>Table 2</option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-success">Confirm</button>
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>Sarah Brown</td>
                    <td>19:00</td>
                    <td>2</td>
                    <td>Table 5</td>
                    <td class="status-confirmed">Confirmed</td>
                    <td>
                        <select class="form-select">
                            <option>Table 5</option>
                            <option>Table 6</option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary">Edit</button>
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- New Reservation Modal -->
    <div class="modal fade" id="newReservationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content p-3">

                <div class="modal-header border-0">
                    <h4 class="modal-title">New Reservation</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Guest Name</label>
                        <input type="text" class="form-control" placeholder="Enter full name">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" class="form-control" placeholder="Enter phone number">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date</label>
                            <input type="date" class="form-control">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Time</label>
                            <input type="time" class="form-control">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Number of Guests</label>
                        <input type="number" class="form-control" min="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Assign Table</label>
                        <select class="form-select">
                            <option>Select Table</option>
                            <option>Table 1</option>
                            <option>Table 2</option>
                            <option>Table 3</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Special Requests</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>

                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button class="btn btn-primary">
                        Save Reservation
                    </button>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
