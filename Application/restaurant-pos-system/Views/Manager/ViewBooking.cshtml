<!DOCTYPE html>
<html>
<head>
    <title>Emerald POS - Reservations Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        :root {
            --emerald-dark: #0f5132;
            --emerald-light: #00c27a;
            --light-bg: #f4f6f9;
            --dark-bg: #1e1e1e;
            --dark-card: #2b2b2b;
            --dark-table: #2f2f2f;
            --dark-border: #444;
            --dark-hover: #383838;
            --dark-text: #e4e4e4;
        }

        body {
            background-color: var(--light-bg);
            transition: all 0.3s ease;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            border: none;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-emerald {
            background-color: var(--emerald-dark);
            color: white;
            border: none;
        }

            .btn-emerald:hover {
                background-color: #0b3d27;
            }

        table th, table td {
            padding: 18px 25px !important;
        }

        .status-confirmed {
            color: var(--emerald-dark);
            font-weight: bold;
        }

        .status-pending {
            color: orange;
            font-weight: bold;
        }

        .status-cancelled {
            color: red;
            font-weight: bold;
        }

        .modal-content {
            border-radius: 15px;
        }

        /* ---------------- DARK MODE ---------------- */

        body.dark-mode {
            background-color: var(--dark-bg);
            color: var(--dark-text);
        }

            body.dark-mode .card {
                background-color: var(--dark-card);
                color: var(--dark-text);
            }

            /* FORCE TABLE DARK STYLING */
            body.dark-mode .table {
                --bs-table-bg: var(--dark-table);
                --bs-table-striped-bg: var(--dark-table);
                --bs-table-hover-bg: var(--dark-hover);
                --bs-table-border-color: var(--dark-border);
                color: var(--dark-text);
            }

                body.dark-mode .table th,
                body.dark-mode .table td {
                    background-color: var(--dark-table) !important;
                    border-color: var(--dark-border) !important;
                    color: var(--dark-text) !important;
                }

                body.dark-mode .table thead th {
                    background-color: var(--dark-table) !important;
                    color: var(--emerald-light) !important;
                }

            body.dark-mode .table-hover tbody tr:hover {
                background-color: var(--dark-hover) !important;
            }

            body.dark-mode .form-control,
            body.dark-mode .form-select {
                background-color: #3a3a3a;
                border: 1px solid #555;
                color: white;
            }

            body.dark-mode .modal-content {
                background-color: var(--dark-card);
                color: white;
            }

            body.dark-mode .btn-emerald {
                background-color: var(--emerald-light);
                color: black;
            }

                body.dark-mode .btn-emerald:hover {
                    background-color: #00a86b;
                }

            body.dark-mode .status-confirmed {
                color: var(--emerald-light);
            }

        .mode-toggle {
            margin-left: 20px;
        }

    </style>
</head>
<body class="p-4">

    <div class="header-bar mb-4">
        <h2>Reservations Manager</h2>

        <div class="d-flex align-items-center">
            <button class="btn btn-emerald me-3" data-bs-toggle="modal" data-bs-target="#newReservationModal">
                + New Reservation
            </button>

            <div class="form-check form-switch mode-toggle">
                <input class="form-check-input" type="checkbox" id="modeSwitch">
                <label class="form-check-label" for="modeSwitch">Dark Mode</label>
            </div>
        </div>
    </div>

    <div class="card p-4">

        <div class="row mb-4">
            <div class="col-md-4">
                <input type="date" class="form-control">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search by name or phone">
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Guest Name</th>
                    <th>Phone Number</th>
                    <th>Time</th>
                    <th>Guests</th>
                    <th>Table</th>
                    <th>Status</th>
                    <th>Allocate</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>John Smith</td>
                    <td>082 555 1234</td>
                    <td>18:30</td>
                    <td>4</td>
                    <td>Unassigned</td>
                    <td class="status-pending">Pending</td>
                    <td>
                        <select class="form-select">
                            <option>Select Table</option>
                            <option>Table 1</option>
                            <option>Table 2</option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-success">Confirm</button>
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>

    <script>
        const toggle = document.getElementById("modeSwitch");
        toggle.addEventListener("change", function () {
            document.body.classList.toggle("dark-mode");
        });
    </script>

</body>
</html>