@model IEnumerable<restaurant_pos_system.Models.ApplicationUser>
@{
    ViewData["Title"] = "Staff";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Staff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">💎 Staff</span>
        <a href="/Manager/Dashboard" class="btn btn-outline-light btn-sm">← Dashboard</a>
    </nav>
    <div class="container mt-4">
        <table class="table table-bordered bg-white shadow-sm">
            <thead class="table-dark">
                <tr><th>Username</th><th>Email</th><th>Role</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-dark">@user.RoleType</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>