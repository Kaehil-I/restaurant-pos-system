<!DOCTYPE html>
<html>
<head>
    <title>New Reservation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #f4f6f9, #e9ecef);
            --panel-bg: #ffffff;
            --card-bg: #ffffff;
            --text-primary: #1f2a38;
            --text-secondary: #6c757d;
            --btn-outline: #6c757d;
            --btn-primary-bg: #0d6efd;
        }

        body.dark-mode {
            --bg-gradient: linear-gradient(135deg, #121c2b, #1f2a38); /* darker top & bottom for strips */
            --panel-bg: #18222f;
            --card-bg: #243447;
            --text-primary: #ffffff;
            --text-secondary: #b0b8c1;
            --btn-outline: #b0b8c1;
            --btn-primary-bg: #00c27a;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh; /* ensures the gradient covers the full page */
            display: flex;
            flex-direction: column;
            transition: 0.3s ease;
        }

        .form-card {
            max-width: 750px;
            margin: 60px auto;
            padding: 40px;
            border-radius: 15px;
            background: var(--card-bg);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            color: var(--text-primary);
            transition: 0.3s ease;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 20px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        label {
            color: var(--text-primary);
        }

        input, textarea {
            background: var(--panel-bg);
            color: var(--text-primary);
            border: 1px solid #ccc;
        }

            input::placeholder, textarea::placeholder {
                color: var(--text-secondary);
            }

        /* Buttons */
        .btn-outline-secondary {
            color: var(--text-primary);
            border-color: var(--btn-outline);
        }

            .btn-outline-secondary:hover {
                background-color: var(--btn-outline);
                color: var(--text-primary);
            }

        .btn-primary {
            background-color: var(--btn-primary-bg);
            border-color: var(--btn-primary-bg);
        }

            .btn-primary:hover {
                opacity: 0.9;
            }

        .mode-toggle {
            position: absolute;
            top: 20px;
            right: 30px;
        }
    </style>
</head>
<body>

    <!-- Dark Mode Toggle -->
    <div class="mode-toggle form-check form-switch">
        <input class="form-check-input" type="checkbox" id="modeSwitch">
        <label class="form-check-label" for="modeSwitch">Dark Mode</label>
    </div>

    <div class="container flex-grow-1 d-flex flex-column justify-content-center">
        <div class="form-card">

            <div class="header-bar">
                <h3>Create New Reservation</h3>
                <button class="btn btn-outline-secondary">← Back</button>
            </div>

            <form>

                <!-- Guest Information -->
                <h5 class="section-title">Guest Information</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" class="form-control" placeholder="Enter guest name">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" class="form-control" placeholder="Enter phone number">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" placeholder="Enter email (optional)">
                </div>

                <!-- Reservation Details -->
                <h5 class="section-title">Reservation Details</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Time</label>
                        <input type="time" class="form-control">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Number of Guests</label>
                        <input type="number" min="1" class="form-control">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Special Requests</label>
                    <textarea class="form-control" rows="3" placeholder="Allergies, birthday celebration, window seat, etc."></textarea>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-3">
                    <button type="button" class="btn btn-outline-secondary">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Save Reservation
                    </button>
                </div>

            </form>

        </div>
    </div>

    <script>
        const toggle = document.getElementById("modeSwitch");
        toggle.addEventListener("change", function () {
            document.body.classList.toggle("dark-mode");
        });
    </script>

</body>
</html>