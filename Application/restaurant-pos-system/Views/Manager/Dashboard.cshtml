@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Manager Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">💎 Emerald POS — Manager</span>
        <a href="/Account/Logout" class="btn btn-outline-light btn-sm">Logout</a>
    </nav>
    <div class="container mt-4">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card text-white bg-success text-center p-3">
                    <h6>Today's Sales</h6>
                    <h3>R @ViewBag.TotalSalesToday?.ToString("F2")</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white bg-primary text-center p-3">
                    <h6>Orders Today</h6>
                    <h3>@ViewBag.OrdersToday</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white bg-warning text-center p-3">
                    <h6>Active Orders</h6>
                    <h3>@ViewBag.ActiveOrders</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-white bg-danger text-center p-3">
                    <h6>Low Stock Items</h6>
                    <h3>@ViewBag.LowStock</h3>
                </div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a href="/Manager/Orders" class="btn btn-outline-dark w-100 p-3">📋 Orders</a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/Manager/Stock" class="btn btn-outline-dark w-100 p-3">📦 Stock</a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/Manager/Staff" class="btn btn-outline-dark w-100 p-3">👥 Staff</a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/Manager/Sales" class="btn btn-outline-dark w-100 p-3">💰 Sales</a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/Manager/Reservations" class="btn btn-outline-dark w-100 p-3">📅 Reservations</a>
            </div>
        </div>
    </div>
</body>
</html>