 <!-- Sidebar -->
        <div class="sidebar">
            <h2>💎 Emerald POS</h2>

            <ul>
                <li><a asp-controller="Manager" asp-action="Dashboard">Dashboard</a></li>
                <li><a asp-controller="Manager" asp-action="Orders">Orders</a></li>
                <li><a asp-controller="Manager" asp-action="Stock">Stock</a></li>
                <li><a asp-controller="Manager" asp-action="Staff">Staff</a></li>
            </ul>

            <!-- Theme Switch -->
            <div class="theme-switch">
                <span>🌞</span>
                <label class="switch">
                    <input type="checkbox" id="themeToggle">
                    <span class="slider round"></span>
                </label>
                <span>🌙</span>
            </div>
        </div>

<h1>Stock Control</h1>

<table>
    <thead>
        <tr>
            <th>Item</th>
            <th>Quantity</th>
            <th>Reorder Level</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Tomatoes</td>
            <td>15</td>
            <td>10</td>
