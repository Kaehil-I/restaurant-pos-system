@model IEnumerable<restaurant_pos_system.Models.Payment>
@{
    ViewData["Title"] = "Sales";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">💎 Sales</span>
        <a href="/Manager/Dashboard" class="btn btn-outline-light btn-sm">← Dashboard</a>
    </nav>
    <div class="container mt-4">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-success text-center p-3">
                    <h6>Today's Revenue</h6>
                    <h3>R @ViewBag.TodayTotal?.ToString("F2")</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-primary text-center p-3">
                    <h6>All-Time Revenue</h6>
                    <h3>R @ViewBag.AllTimeTotal?.ToString("F2")</h3>
                </div>
            </div>
        </div>
        <table class="table table-bordered bg-white shadow-sm">
            <thead class="table-dark">
                <tr><th>Order #</th><th>Amount</th><th>Method</th><th>Paid At</th><th>Receipt</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.OrderId</td>
                        <td>R @p.TotalAmount.ToString("F2")</td>
                        <td>@p.PaymentMethod</td>
                        <td>@p.PaidAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td><a href="/Sales/Receipt/@p.OrderId" class="btn btn-sm btn-outline-primary">Receipt</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>