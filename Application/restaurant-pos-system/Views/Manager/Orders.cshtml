@model IEnumerable<restaurant_pos_system.Models.Order>
@{
    ViewData["Title"] = "All Orders";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand fw-bold">💎 Orders</span>
        <a href="/Manager/Dashboard" class="btn btn-outline-light btn-sm">← Dashboard</a>
    </nav>
    <div class="container mt-4">
        <table class="table table-bordered table-striped bg-white shadow-sm">
            <thead class="table-dark">
                <tr><th>#</th><th>Table</th><th>Items</th><th>Total</th><th>Status</th><th>Time</th><th>Receipt</th></tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    decimal total = order.OrderItems.Sum(i => i.Price * i.Quantity);
                    <tr>
                        <td>@order.Id</td>
                        <td>Table @order.RestaurantTable?.TableNumber</td>
                        <td>@order.OrderItems.Count</td>
                        <td>R @total.ToString("F2")</td>
                        <td><span class="badge bg-secondary">@order.Status</span></td>
                        <td>@order.CreatedAt.ToString("dd MMM HH:mm")</td>
                        <td>
                            @if (order.Status == "Paid")
                            {
                                <a href="/Sales/Receipt/@order.Id" class="btn btn-sm btn-outline-primary">Receipt</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>